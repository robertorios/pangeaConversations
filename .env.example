# Copy to .env:  cp .env.example .env
# Use the same DB_USER / DB_PASS as pangeaUsers (one MySQL account for all apps in dev).
# Create the user with pangeaUsers/config/mysql_development_user.sql

DB_USER=pangea_dev
DB_PASS=change_me_local_only

# JWT verification secret. MUST be the SAME value in all three services
# (pangeaUsers, pangeaMedia, pangeaConversations) — websocket connections
# present a token minted by pangeaUsers and it is verified here. Generate with:
#   ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
JWT_SECRET_KEY=

# pangeaUsers base URL + shared token for fetching admin ids (chat observers).
USERS_SERVICE_URL=http://127.0.0.1:3000
INTERNAL_SERVICE_TOKEN=

# Optional comma-separated admin user ids used when the users service is
# unreachable or INTERNAL_SERVICE_TOKEN is unset (local/dev fallback).
# SUPERVISOR_USER_IDS=4,6

# Comma-separated SPA Origins for CORS (credentials). Exact URLs only — no "*".
# Development includes localhost defaults; production REQUIRES this list.
# CORS_ALLOWED_ORIGINS=https://your-spa.example
